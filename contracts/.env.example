# Forge loads contracts/.env. Local chain 31337 has development-key/role defaults.
# Keep real keys in the ignored .env only.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Required for Sepolia deployment: funded key and participant addresses.
# DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# BUYER_ADDRESSES=0xYOUR_BUYER_ADDRESS
# PROVIDER_ADDRESSES=0xYOUR_PROVIDER_ADDRESS
# VERIFIER_ADDRESSES=0xYOUR_INDEPENDENT_VERIFIER_ADDRESS
# REGISTRAR_ADDRESSES=0xOPTIONAL_EXTRA_REGISTRAR

# Zero address deploys the chosen 18-decimal MockETH (mETH).
SETTLEMENT_TOKEN=0x0000000000000000000000000000000000000000
SETTLEMENT_DELAY=0
APPEAL_WINDOW=259200

# SeedDemo keys required on Sepolia; Anvil has local defaults.
# BUYER_PRIVATE_KEY=0xYOUR_BUYER_PRIVATE_KEY
# PROVIDER_PRIVATE_KEY=0xYOUR_PROVIDER_PRIVATE_KEY
# VERIFIER_PRIVATE_KEY=0xYOUR_INDEPENDENT_VERIFIER_PRIVATE_KEY
DEMO_DEADLINE_DELAY=180
DEMO_STOP_AFTER=settle
