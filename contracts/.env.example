# Forge loads contracts/.env. It holds NO keys: Sepolia scripts sign with encrypted Foundry keystores
# (--account <alias>), and role addresses come from config/wallets.sepolia.json. Anvil uses its public dev keys.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Claim settings fixed at deployment (seconds).
SETTLEMENT_DELAY=0
APPEAL_WINDOW=259200

# RunSepoliaE2E: case id (change it to start a fresh case) and seconds until the delivery deadline.
E2E_RUN_ID=SEPOLIA-E2E-001
E2E_DEADLINE_DELAY=300

# Local demo seeding (SeedDemo / SeedDemoClaim).
DEMO_DEADLINE_DELAY=180
DEMO_STOP_AFTER=settle
