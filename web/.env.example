# Public browser configuration
NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=true
NEXT_PUBLIC_DEFAULT_CHAIN_ID=31337
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_LOG_CHUNK_SIZE=20000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Server only: never expose this key in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
LOCAL_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACTS_DEPLOYMENTS_DIR=../contracts/deployments
# Hosted alternative: JSON array copied from actual deployment files.
# SUPPLYRIGHT_DEPLOYMENTS=[]

# Optional offchain demo seed overrides; defaults use Anvil accounts #0–#3.
DEMO_CHAIN_ID=31337
# DEMO_BUYER_ADDRESS=0x...
# DEMO_REGISTRAR_ADDRESS=0x...
# DEMO_PROVIDER_ADDRESS=0x...
# DEMO_VERIFIER_ADDRESS=0x...
